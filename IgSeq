#!/usr/bin/env perl

our $VERSION = "";
our $VERSION_DATE = "";

=pod

=head1 NAME

IgSeq - Pipeline for processing IMGT/High-Vquest files into lineage clusters

=head1 SYNOPSIS

	perl IgSeq

=head1 DESCRIPTION

=head1 USAGE

   perl IgSeq
   perl IgSeq <merge> <lineage> <compare>

=cut

use strict;
use warnings;
use POSIX;
use Data::Dumper;
use Carp;
use File::Path qw(make_path);
use Parallel::ForkManager;
use Sys::CPU qw(cpu_count);
use File::Spec;
use File::Find;
use FindBin;
use lib "$FindBin::RealBin/lib/";

use db;
use merge qw(merge);
use lineage qw(lineage);

use subsetMerge;

my $path = $FindBin::RealBin;
my @args = @ARGV;
my $inputDir;

my $config = File::Spec->catdir($path, 'config');
opendir my $DIR, $config or die "Can not open directory $config $!\n";
my @linSettingsFiles = grep {/lineage\d*\.inf/} readdir $DIR;
closedir $DIR;

print "Enter output database name: ";
my $au_name = <STDIN>;
chomp $au_name;
my $datetime = POSIX::strftime("%Y_%m_%d_%H_%M_%S", localtime);
my $db_name = $au_name."_".$datetime;


open my $QFILTER, "$config/postAlignQfilter.inf" or die "Error $!\n";
my $flag1 = 0;
my $flag2 = 0;
my %qfilterSettings;
my $filterID;
my $filePairID;


# read input directories
	$inputDir = File::Spec->catdir($path, 'data');
	opendir my $IND, $inputDir or die "Can not open data directory $!\n";
	my @subDirs = grep { !/^\./ } readdir $IND;
	closedir $IND;

# confirm merge config file present
	my $mergeConfig = File::Spec->catfile($config, 'merge.inf');
	die "Can not find merge configuration file $!\n" if !-f $mergeConfig;


# read each input directory's set of v-quest files
	my %input;
	foreach my $subdir (@subDirs){
		my $popDir = File::Spec->catdir($inputDir,$subdir);
		opendir $IND, $popDir or die "Can not open data directory $popDir : $!";
		my @files = sort readdir $IND;
		closedir $IND;

		push(@{$input{$subdir}}, grep {/(^2\_)|(^4\_)|(^8\_)/i} @files);
	}

# merge subsets if settings require
	my $results = subsetMerge::mergeSubset(\%input, $path) if ((defined($args[0]) && grep {/merge/} @args) || !defined($args[0]));
	%input = %{$results} if $results;

# check if postVquest filter is on

while (<$QFILTER>){
	chomp;
	if ($_ =~ /^%(.*)/){
		$filterID = $1;
		$flag1 = 1;
	}elsif($_ =~ /^#(.*)/){
		$filePairID = $1;
		$flag2 = 1;
	}elsif($flag1 == 1){
		my @r;
		$r[1] = $_;
		$r[2] = <$QFILTER>;
		$r[3] = <$QFILTER>;
		chomp @r;
		for (1..3){
			my ($name,$value) = split ':', $r[$_];
			$qfilterSettings{'qualitySettings'}{$filterID}{$name} = $value;
		}
		my $end = <$QFILTER>;
		$flag1 = 0;
	}elsif($flag2 == 1){
		my $folder = $_;
		my $file = <$QFILTER>;
		chomp ($file,$folder);
		push @{$qfilterSettings{'filePairings'}{$filePairID}}, ($folder, $file);
		$flag2 = 0;
	}else{
		my @row = split ':';
		$qfilterSettings{$row[0]} = $row[1];
	}
}

if ( ($qfilterSettings{'run'} eq 'y') && ((defined($args[0]) && grep {/postAlignFilter/} @args) || !defined($args[0])) ){

print "\n##################################################\n";
print   "             Post V-quest Quality filter\n";
print   "##################################################\n";
	mkdir File::Spec->catdir($path, 'postVquestFiltered');
	
	$inputDir = File::Spec->catdir($path, 'subsetMerged') if $results;
	
	opendir my $IND, $inputDir or die "Can not open data directory $!\n";
	my @subDirs = grep { !/^\./ } readdir $IND;
	closedir $IND;

	my $fastqDir = File::Spec->catdir($path, 'data_fastq');
	opendir $IND, $fastqDir or die "Can not open data directory $!\n";
	my @fastqFiles = grep { !/^\./ } readdir $IND;
	closedir $IND;

	my $qualitySettings;
	foreach my $q (sort keys %{$qfilterSettings{'qualitySettings'}}){
		$qualitySettings .= "$qfilterSettings{'qualitySettings'}{$q}{'start'} ".
							"$qfilterSettings{'qualitySettings'}{$q}{'stop'} ".
							"$qfilterSettings{'qualitySettings'}{$q}{'q>='} ";
	}
	
	foreach my $pair (keys %{$qfilterSettings{'filePairings'}}){
		my $vquestFile = "$inputDir/$qfilterSettings{'filePairings'}{$pair}->[0]/2_IMGT-gapped-nt-sequences*.txt";
		my $vquest4file = "$inputDir/$qfilterSettings{'filePairings'}{$pair}->[0]/4_IMGT-gapped-AA-sequences*.txt";
		my $vquest8file = "$inputDir/$qfilterSettings{'filePairings'}{$pair}->[0]/8_V-REGION-nt-mutation-statistics*.txt";
		my $fastqFile = "$fastqDir/$qfilterSettings{'filePairings'}{$pair}->[1].fastq";
		
		my $cmd = "matlab -nosplash -nodesktop -r \"path(path,\'$path/lib/postVDJfilter\'); ".
					"postVquestQfilter $fastqFile $vquestFile $vquest4file $vquest8file $qualitySettings $qfilterSettings{'filePairings'}{$pair}->[0]\"";
		print $cmd."\n";
		system($cmd);
	}
	
	
}

print "\n##################################################\n";
print   "                     MERGE\n";
print   "##################################################\n";


# for each pop directory run merge
	my $pm = Parallel::ForkManager->new(cpu_count()-1);
	
	if ((defined($args[0]) && grep {/merge/} @args) || !defined($args[0])) {
		foreach my $pop (keys %input){
			print "\n\n> Merge processing set $pop\n";
			my $pid = $pm->start and next;
			if($results){
				my $sourceDir = $qfilterSettings{'run'} eq 'y' ? 'postVquestFiltered' : 'subsetMerged' ;
				$inputDir =~ s/\/data//;
				my $v2 = File::Spec->catfile(($path, $sourceDir, $pop), $input{$pop}->[0]);
				my $v4 = File::Spec->catfile(($path, $sourceDir, $pop), $input{$pop}->[1]);
				my $v8 = File::Spec->catfile(($path, $sourceDir, $pop), $input{$pop}->[2]);
				merge( $v2, $v4, $v8, $pop);
			}else{
				my $v2 = File::Spec->catfile(($inputDir, $pop), $input{$pop}->[0]);
				my $v4 = File::Spec->catfile(($inputDir, $pop), $input{$pop}->[1]);
				my $v8 = File::Spec->catfile(($inputDir, $pop), $input{$pop}->[2]);
				merge( $v2, $v4, $v8, $pop);
			}
			$pm->finish(0);
		}
	}else{ print "Skipping due to settings...\n"; }
	$pm->wait_all_children();



print "\n##################################################\n";
print   "                     LINEAGE\n";
print   "##################################################\n";

# append to log file whatever shows up on terminal (errors only show up on STDERR on terminal)
my $LOG_FILE = 'lineage_log.txt';
open my $LOG, ">". File::Spec->catfile($path,"lineageOutput",$LOG_FILE);
close $LOG;
open STDOUT, "| tee -a ".File::Spec->catfile($path,"lineageOutput",$LOG_FILE) or croak "Tee stdout error";

	if ((defined($args[0]) && grep {/lineage/} @args) || !defined($args[0])) {
		foreach my $setting(@linSettingsFiles){
			my %linSet;

			open my $INF, "<".File::Spec->catfile($config,'lineage.inf') or die "ERROR: problem in script\n";
		
			while(<$INF>){
				chop;
				my @row = split ':';
				$linSet{$row[0]}=$row[1];
			}
			close $INF;
	
			print "\n##################################################\n";
			print   "                    CDR3:$linSet{cdr3_homology}\n";

			my $dir = File::Spec->catdir($path,'mergeOutput');

			my @files;
			find( sub{push @files,$File::Find::name if /(withIdenticals)|(withOutIdenticals)/}, $dir);
 			opendir $DIR, $dir or die "Can not open data directory $!";
 			@subDirs = grep{!/^\./} readdir $DIR;

 			closedir $DIR;
 			my %fileSuffix;
			foreach my $pop (@subDirs){
				my @subfiles = grep {/$pop/} @files;
				map {s/.*$pop\_//; $fileSuffix{$_} = 1;} @subfiles;
			}		

			my $cpus = cpu_count();
			my $pm = new Parallel::ForkManager($cpus-1);
			my $db_name_base = $db_name;
			foreach my $group (keys %fileSuffix){
				my @groupFiles;

				my ($withIdenticals)    = $group =~ /withIdenticals/;
				my ($withOutIdenticals) = $group =~ /withOutIdenticals/;
				my ($isotype) 			= $group =~ /(.*?)_with.*?\.txt$/;
				my ($v_gene)            = $group =~ /(.*V\d+-\d+)_with.*?\.txt$/;

				next if $withIdenticals     && $linSet{'runWithIdenticals'} eq 'n';
				next if $withOutIdenticals  && $linSet{'runWithoutIdenticals'} eq 'n';
				if ($isotype && $linSet{'runIsotypes'} eq 'n'){
					next;
				}elsif($isotype){
					$db_name = "$isotype\_$db_name_base";
				}else{
					$db_name = $db_name_base;
				}
				next if $v_gene             && $linSet{'runV_genes'} eq 'n';

				#my $pid = $pm->start and next;
	
				print "\n> Lineage processing set $group\n";

				my $outfile;
				$outfile =  "/withIdenticals" if $withIdenticals;
				$outfile =  "/withOutIdenticals" if $withOutIdenticals;
				$outfile .= "/V_gene_$v_gene" if $v_gene;
				$outfile .= "/Isotype_$isotype" if $isotype;

				my @lineageCommand;
				push( @lineageCommand, $group);
				push( @lineageCommand, File::Spec->catfile($config,$setting));
				push( @lineageCommand, "$path");
				push( @lineageCommand, $outfile);
				push( @lineageCommand, $db_name) if !$v_gene && $withIdenticals;

				lineage(@lineageCommand);

				#$pm->finish(0);
			}

			#$pm->wait_all_children;
		}
	}



    print "\n##################################################\n";
    print   "                     Archiving\n";
    print   "##################################################\n";

    print "> Archiving files...\n";
    mkdir("$path/Archive");
	system("tar -C $path -zcf $path/Archive/$au_name\_IgSeq_archive_$datetime.tgz data/ subsetMerged/ mergeOutput/ lineageOutput/ config/circos.inf config/lineage.inf config/merge.inf config/subsetMerge.inf");

    print "> All files archived to IgSeq_archive_$datetime.tgz\n";

