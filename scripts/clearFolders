our $VERSION = '2013.03.29.1';

use strict;
use warnings;
use Data::Dumper;
use File::Path qw(remove_tree);
use FindBin;

my $base = $FindBin::RealBin;
$base =~ s/scripts$//;
print "WARNING: This will remove all data from all output folders except Archive and DB within:\n $base\n".
    "Please make sure all data is backed up before running.\n".
    "Proceed (y|n)? ";
if(<STDIN> =~ 'y'){
    print "Removing files...\n";
    remove_tree("$base".'joinedTrimmed', "$base".'subsetMerged', "$base".'trimmed', "$base".'AbIsotyper_Out', "$base".'fastaOutput', "$base".'fastaSubSample_Out', "$base".'fastQCoutput', "$base".'fastqJoined', "$base".'lineageOutput', "$base".'mergeOutput', "$base".'replicateMergeOutput', "$base".'subSample_Out', "$base".'Summary', "$base".'CDR3_output', "$base".'postVquestFiltered', "$base".'barcodeOutput', {keep_root => 1});
}


1;


=head1 NAME
 
 replicateMerge.pl
 
=head1 SYNOPSIS
 
 perl replicateMerge.pl  
 
=head1 DESCRIPTION
 
 Performs quality filtering as well as the ability to merge technical replicates
    of samples.
 
=head1 SETTINGS
 
 See the replicateConfig.inf file
 
=head1 OUTPUT
 
 FASTQ files filtered based on settings.
 
