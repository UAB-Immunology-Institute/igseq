use strict;
use warnings;

# make sure we have at least 5.10 for some of it's features
use v5.10.1;

# package dependencies
use POSIX;
use Data::Dumper;
use Cwd;
use Carp;
use File::Path qw(make_path remove_tree);
use File::Spec;
use POSIX;
use Sys::CpuAffinity;
use Parallel::ForkManager;
use Tie::File;

my $cpu_count = Sys::CpuAffinity::getNumCpus();

my @args = @ARGV;

# set base directory structure;
use FindBin;
my $working_dir = $FindBin::RealBin;
print "Using ". File::Spec->catfile($working_dir,'lib') ."\n";
use lib File::Spec->catfile($FindBin::RealBin,'lib');

# print debug info to std out
my $verbose = 0;

# log file & run time initialization
my $LOG_FILE = 'fastq_log.txt';
open STDOUT, "| tee -a ".File::Spec->catfile($working_dir,'fastaOutput',"$LOG_FILE") or croak "Tee stdout error";
my $RUN_TIME = POSIX::strftime("%Y-%m-%d, %H:%M:%S", localtime);
my $datetime = POSIX::strftime("%Y_%m_%d_%H_%M_%S",localtime);

# Set initial data directory
my $dir = File::Spec->catfile($working_dir,'data_fastq');

# throw error if dir is not present
die "Error: need directory input." if ! -d $dir;

# get list of fastq files in data_fastq directory
opendir DIR, $dir or die "Error: can not open data directory $dir: $!\n";
my @files = grep{ /(?:(\.fastq|\.gz))$/} sort readdir DIR;
closedir DIR;

# throw error if no files found
if(!@files){die "Error did not find any .fastq files in $dir.\n";}

# otherwise continue
print "Found files:\n";
print join("\n", @files)."\n\n";



# set up hash to check fastqSettings file against.
my %fastqOptions = ('p' 	=>0,
					'm' 	=>0,
					'r' 	=>0,
					'v' 	=>0,
					'trim'	=>0);

############################################################
# make sure settings files are good before running scripts #
############################################################

# read settings file for joining
my %fastqSettings;
open INF, '<', File::Spec->catfile($working_dir,'config','fastq-join.inf') or die "Error: can not open fastq-join.inf\n";
while(<INF>){
	chomp;
	my @line = split ":";
	$fastqSettings{$line[0]} = $line[1] if $line[0] !~ /^\#/; #skips '#' commented lines
	carp "Unknown setting for fastq-join: $line[0] " if !exists $fastqOptions{$line[0]}; # check against specified options
	$fastqOptions{$line[0]} = 1;
}
close INF;
my $sum;
map {$sum+=$_;} values %fastqOptions;
carp "Not all settings present in fastq-join.inf\n" if $sum != 5;

# read settings file for subSample
my %subSample_settings;
open INF, '<', File::Spec->catfile($working_dir,'config','fastaSubSample.inf') or die "Error: can not open fastaSubSample.inf\n$!\n";
while(<INF>){
	chop;
	my @line = split ":";
	$subSample_settings{$line[0]} = $line[1];
}
close INF;


# Set up output paths for all scripts
make_path(File::Spec->catdir($working_dir,'fastaOutput'));
make_path(File::Spec->catdir($working_dir,'fastQCoutput'));
make_path(File::Spec->catdir($working_dir,'replicateMergeOutput'));
make_path(File::Spec->catdir($working_dir,'fastqJoined'));
make_path(File::Spec->catdir($working_dir,'trimmed'));
make_path(File::Spec->catdir($working_dir,'joinedTrimmed'));
make_path(File::Spec->catdir($working_dir,'barcodeOutput'));
make_path(File::Spec->catdir($working_dir,'fastQCoutput','Filtered'));
make_path(File::Spec->catdir($working_dir,'Archive'));

# setup fork processes for up to # cores - 1
my $pm = new Parallel::ForkManager($cpu_count-1); 

# start running scripts
	print "##################################################\n";
	print "                     FASTQ-JOIN\n";
	print "##################################################\n";

	print "> script start: $RUN_TIME\n";


	
	# files should be ordered R1, R2 so iterate by 2;  may not be true on non-OS x systems
	for(my $i = 0; $i < $#files; $i = $i+2){
		my $pid = $pm->start and next; # fork process
		
		# get basename for output
		$files[$i] =~ /(.*)\_R.*(\.fastq)/;
		my $out = $1."\_\%".$2;

		# file checks
		my @file1 = split '\_R', $files[$i];
		my @file2 = split '\_R', $files[$i+1];
		croak "Error: File input names do not match.\n$files[$i]\n$files[$i+1]\n" if $file1[0] ne $file2[0];
	
		print "Starting join...\n$files[$i]\t$files[$i+1]\n";

		# setup command to execute
		my $fastqJoin_cmd = File::Spec->catfile($working_dir,'lib','fastq-join ').
							File::Spec->catfile($working_dir,'data_fastq',"$files[$i] ").
							File::Spec->catfile($working_dir,'data_fastq',"$files[$i+1] -o ").
							File::Spec->catfile($working_dir,'fastqJoined',"$out");

		foreach my $key (keys %fastqSettings){
			next if $key eq 'trim';
			my ($base) = split '_', $out;
			$fastqSettings{$key} = File::Spec->catfile($working_dir,'fastqJoined',$base.$fastqSettings{$key}) if $key eq 'r';
			$fastqJoin_cmd .= " -$key $fastqSettings{$key}";
		}

		print "\n$fastqJoin_cmd\n" if $verbose;
		system($fastqJoin_cmd);

		# reset out to use as input for FastQC
		$out =~ s/\%/join/;
		
		# run FastQC on joined file
		print "\nRunning FastQC on joined file...\n";
		print "\n$working_dir/lib/FastQC/fastqc $working_dir/fastqJoined/$out --outdir=$working_dir/fastQCoutput/ --noextract\n" if $verbose;
		my $fastqcCMD = File::Spec->catfile($working_dir,'lib','FastQC','fastqc ').
						File::Spec->catfile($working_dir,'fastqJoined',"$out --outdir=").
						File::Spec->catfile($working_dir,'fastQCoutput',' --noextract');
		system($fastqcCMD);
		
		$pm->finish(0);
		
	}
	$pm->wait_all_children;
	
	print "> script finished: ".POSIX::strftime("%Y-%m-%d, %H:%M:%S", localtime)."\n";

	# copy files over to joinedTrimmed folder for next step if trimming is on
	my $cpCMD = File::Spec->catfile($working_dir,'fastqJoined','*join.fastq ',$working_dir,'joinedTrimmed');
	system("cp $cpCMD") if $fastqSettings{'trim'} eq 'on';
	print "cp $cpCMD\n" if $verbose && $fastqSettings{'trim'} eq 'on';

	# get list of joined files
	opendir my $DIR, File::Spec->catfile($working_dir,'fastqJoined') or die "Error opening fastqJoined directory\n$!\n";
	my @joinedFiles = grep {/\_join\.fastq/} sort readdir $DIR;
	closedir $DIR;

	# hash of seq IDs that were joined
	my %joined;
	foreach my $joinFile (@joinedFiles){
		open my $INF, '<', File::Spec->catfile($working_dir,'fastqJoined',$joinFile) or die "Error opening $joinFile\n$!\n";
		while (<$INF>){
			chomp;
			if ($_ =~ /^\@.*?:\d+?:\d+?-/){
				my ($baseFileName) = $joinFile =~ /(.*)\_join/i;
				$joined{$baseFileName}{$_} = 1;
			}
		}
		close $INF;
	}
my %pairNames;
map {$_ =~ /(.*?)_R[12]/; $pairNames{$1}=1; } @files;

#$verbose = 1;
	# if trimming is turned on
	if ($fastqSettings{'trim'} eq 'on'){
		print "Trimming files...\n";
		
		foreach my $pair(keys %pairNames){
			my $pid = $pm->start and next;
			
			my @pairFiles = grep {/$pair/} @files;
			print "$pair\n";
			die "Error, Sample names are too similar.\n" if scalar(@pairFiles) > 2;
			
			my $out = $pair."\.fastq";

			for (my $i = 0; $i <= $#pairFiles; $i++){	
				if ($pairFiles[$i] =~ /(?:\.gz)|(?:\.tgz)$/){
					my ($fn) = $pairFiles[$i] =~ s|\.(t)?gz||r;
					my $gunzipCMD = File::Spec->catfile($working_dir,'data_fastq',"$pairFiles[$i] > ").
									File::Spec->catfile($working_dir,'trimmed',$pairFiles[$i]);
					print "gunzip -c $gunzipCMD" if $verbose;
					system("gunzip -c $gunzipCMD");
				}else{
					$cpCMD = File::Spec->catfile($working_dir,'data_fastq',$pairFiles[$i],' ').
							 File::Spec->catfile($working_dir,'trimmed',$pairFiles[$i]);
					print "cp cpCMD\n" if $verbose;
					system("cp cpCMD");
				}
				#print "perl $working_dir/lib/condetri_v2.2.pl -fastq1=$working_dir/trimmed/$pairFiles[$i] -sc=33 -hq=35\n" if $verbose;
				#system("perl $working_dir/lib/condetri_v2.2.pl -fastq1=$working_dir/trimmed/$pairFiles[$i] -sc=33 -hq=35");
				my $out = $pairFiles[$i];
				$out =~ s/(\.fastq)/_trim$1/g;
				system("cp $working_dir/trimmed/$pairFiles[$i] $working_dir/trimmed/$out");
			}

			# execute trimming command
			#print "perl $working_dir/lib/condetri_v2.2.pl -fastq1=$working_dir/trimmed/$pairFiles[0] -fastq1=$working_dir/trimmed/$pairFiles[1] -sc=33\n" if $verbose;
			
			
			my ($trim_out) = $out =~ s/\.fastq/_trim\.fastq/r;
			
			$pm->finish(0);	
		}
		$pm->wait_all_children;

		print "\nConcatenating trimmed and joined sequences\n" if $verbose;
		opendir my $DIR, "$working_dir/joinedTrimmed" or die "Error opening Directory $!\n";
		@joinedFiles = grep {/\_join\.fastq$/} sort readdir $DIR;
		closedir $DIR;
	#print '@joinedFiles' ."\n";
	#print Dumper @joinedFiles;

# 		foreach my $file (@joinedFiles){
# 			my ($base) = $file =~ /(.*)\_join/i;	
# 			print "Joined file: $file\n" if $verbose;
		my %baseFileNames;
		opendir $DIR, "$working_dir/trimmed" or die "Error opening directory $!\n";
		my @trimmedFiles = grep {/\_R.*\_trim\.fastq/} sort readdir $DIR;
		map {my ($name) = $_ =~ /(.*?)\_R.*\_trim\.fastq/; $baseFileNames{$name}=1;} @trimmedFiles;
		closedir $DIR;		
		my %trimmed;
#print Dumper %baseFileNames;
#print Dumper @trimmedFiles;

		foreach my $base (keys %baseFileNames){
			my ($file) = grep {/$base/} @joinedFiles;
			print "Merging Joined file: $file\n";
			#my $hold = <STDIN>;
			foreach my $trimFile (grep {/$base/} @trimmedFiles){
				print "\tTrimmed file: $trimFile\n";
				my ($baseFileName) = $trimFile =~ /(.*)\_R/i;
				open my $INF, "$working_dir/trimmed/$trimFile" or die "Error opening file $!\n";
				while (<$INF>){
					chomp;
					if ($_ =~ /^\@.*?:\d+?:\d+?-/){
						my ($seqid) = split '\s';
						next if($joined{$baseFileName}{$seqid});

						if ($trimFile =~ /R1/){
							my $seq = <$INF>;
							chomp($seq);
							my $rev_seq = reverse $seq;
							my $skip = <$INF>;
							my $qual = <$INF>;
							chomp($qual);
							$rev_seq =~ tr/ACGTacgt/TGCAtgca/;
							$trimmed{$baseFileName}{$seqid}{'R1'}{'seq'} = $rev_seq;
							$trimmed{$baseFileName}{$seqid}{'R1'}{'qual'} = reverse $qual;
						}elsif ($trimFile =~ /R2/){
							my $seq = <$INF>;
							chomp $seq;
							$trimmed{$baseFileName}{$seqid}{'R2'}{'seq'} = $seq;
							my $skip = <$INF>;
							my $qual = <$INF>;
							chomp $qual;
							$trimmed{$baseFileName}{$seqid}{'R2'}{'qual'} = $qual;
						}
					}
				}	
				close $INF;	
			}
			print "Generating Joined/Trimmed output $file\n";
			#$hold=<>;
			open my $OPF, ">>". "$working_dir/joinedTrimmed/$file" or die "Error opening file $!\n";
#print Dumper keys $joined{$base};
#print Dumper keys $trimmed{$base};
			foreach my $seq (keys %{$trimmed{$base}}){
				next if $joined{$base}{$seq};
				#print "$seq\n";
				#print Dumper $trimmed{$base}{$seq}{'R1'};
				#print Dumper $trimmed{$base}{$seq}{'R2'};
				#print "\n\n";
				
				if ($trimmed{$base}{$seq}{'R1'} && $trimmed{$base}{$seq}{'R2'}){
					print $OPF "$seq\n" . $trimmed{$base}{$seq}{'R2'}{'seq'} . $trimmed{$base}{$seq}{'R1'}{'seq'} . "\n" . "+\n" . $trimmed{$base}{$seq}{'R2'}{'qual'} . $trimmed{$base}{$seq}{'R1'}{'qual'} . "\n";
				#	print "$seq\n" . $trimmed{$base}{$seq}{'R2'}{'seq'} . $trimmed{$base}{$seq}{'R1'}{'seq'} . "\n" . "+\n" . $trimmed{$base}{$seq}{'R2'}{'qual'} . $trimmed{$base}{$seq}{'R1'}{'qual'} . "\n";
				}
			}
			close $OPF;
		}
	}


print "##################################################\n";
print "       Replicate Merge & Quality Filtering\n";
print "##################################################\n";


my $repmergeCMD = File::Spec->catfile($working_dir,'lib','replicateMerge.pl ');
$repmergeCMD .= File::Spec->catfile($working_dir,'fastqJoined') if $fastqSettings{'trim'} eq 'off';
$repmergeCMD .= File::Spec->catfile($working_dir,'joinedTrimmed') if $fastqSettings{'trim'} eq 'on';

system("perl $repmergeCMD");

opendir my $DIRH, File::Spec->catfile($working_dir,'replicateMergeOutput') or die "error opening directory $!\n"; 
@files = grep {/\.fastq/} sort readdir $DIRH;
my @fasta_files = @files;
map { $_ = File::Spec->catfile($working_dir,'replicateMergeOutput',$_) } @files;

my $fastqcCMD = File::Spec->catfile($working_dir,'lib','FastQC','fastqc '.join(" ", @files)).
				File::Spec->catfile(" --outdir=$working_dir",'fastQCoutput','Filtered --noextract');
system($fastqcCMD);

foreach my $file (@fasta_files){
	my ($out) = $file =~ /(.*)\.fastq/;
	my $fastq2aCMD = File::Spec->catfile($working_dir,'lib','fastQ2A.pl ').
					 File::Spec->catfile($working_dir,'replicateMergeOutput',"$out.fastq");
    system("perl $fastq2aCMD");
}


if($subSample_settings{run} eq 'y'){
	print "##################################################\n";
	print "                     Sub-Sampling\n";
	print "##################################################\n";
	

	if(defined $subSample_settings{size}){
		my $fastasubsampleCMD = File::Spec->catfile($working_dir,'lib','fastaSubSample.pl ').
								File::Spec->catfile($working_dir,'fastaOutput ').
								"-size:$subSample_settings{size} -seed:$subSample_settings{seed}";
		system("perl $fastasubsampleCMD");
	}else{
		croak "Error: Problem with sub-sampling settings. \n";
	}
	
	
	print "##################################################\n";
	print "                     AbIsotype\n";
	print "##################################################\n";
	
	my $abisotyperCMD = File::Spec->catfile($working_dir,'lib','AbIsotyper.pl ').
						File::Spec->catfile($working_dir,'fastaSubSample_Out -diff:2');
	system("perl $abisotyperCMD");
	
	
	
	print "\n##################################################\n";
	print   "                     Archiving\n";
	print   "##################################################\n";
	
	print "> Archiving files...\n";
	my $archCMD = File::Spec->catfile($working_dir,'Archive',"fastq_analysis_$datetime.tgz ").
				  "joinedTrimmed trimmed fastqJoined fastaOutput AbIsotyper_Out fastQCoutput replicateMergeOutput fastaSubSample_Out ".
				  File::Spec->catfile('config','AbIsotyper_labels.inf ').
				  File::Spec->catfile('config','fastaSubSample.inf ').
				  File::Spec->catfile('config','fastq-join.inf ').
				  File::Spec->catfile('config','replicateConfig.inf');
    system("tar -C $working_dir -zcf $archCMD");

}else{
	
	print "##################################################\n";
	print "                     AbIsotype\n";
	print "##################################################\n";
	
	my $abisotyperCMD = File::Spec->catfile($working_dir,'lib','AbIsotyper.pl ').
						File::Spec->catfile($working_dir,'fastaOutput -diff:2');
	system("perl $abisotyperCMD");
	
	print "\n##################################################\n";
	print   "                     Archiving\n";
	print   "##################################################\n";
	
	print "> Archiving files...\n";

	my $archCMD = File::Spec->catfile($working_dir,'Archive',"fastq_analysis_$datetime.tgz ").
				  "joinedTrimmed trimmed fastqJoined fastaOutput AbIsotyper_Out fastQCoutput replicateMergeOutput fastaSubSample_Out ".
				  File::Spec->catfile('config','AbIsotyper_labels.inf ').
				  File::Spec->catfile('config','fastaSubSample.inf ').
				  File::Spec->catfile('config','fastq-join.inf ').
				  File::Spec->catfile('config','replicateConfig.inf');
    system("tar -C $working_dir -zcf $archCMD");    
    
}

	print "> All files archived to fastq_analysis_$datetime.tgz\n";
	print "Have a nice day!\n";
=cut